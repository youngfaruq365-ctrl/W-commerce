# ============================================================
# W-COMMERCE ENVIRONMENT TEMPLATE
# ============================================================
# HOW TO USE:
#   Development → copy to .env         (git-ignored)
#   Production  → copy to .env.production (NEVER commit)
#
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Variables marked [REQUIRED] will cause the server to refuse
# to start if missing. Variables marked [OPTIONAL] degrade
# gracefully with a warning in the server log.
# ============================================================


# ── SERVER ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Public URL of the frontend app (no trailing slash)
FRONTEND_URL=http://localhost:5175
# Alias used in some older service files — keep in sync with FRONTEND_URL
CLIENT_URL=http://localhost:5175

# For subfolder deployments (e.g. /app). Leave blank for root.
BASE_PATH=


# ── DATABASE ─────────────────────────────────────────────────
# Development (SQLite — local only, NOT for production)
DATABASE_URL=file:./prisma/dev.db

# Production (PostgreSQL — required in production)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public


# ── REDIS ────────────────────────────────────────────────────
# [OPTIONAL in dev, REQUIRED in production]
# Used for: session store, rate limiting, caching, pub/sub
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD@your-redis-host:6379/0

# Prefix for session keys in Redis (default: "sess:")
REDIS_SESSION_PREFIX=sess:

# Connection retry tuning
REDIS_CONNECT_RETRIES=5
REDIS_RETRY_BASE_MS=1000


# ── SECURITY ─────────────────────────────────────────────────
# [REQUIRED] — Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# AES encryption key for sensitive DB fields (32 bytes → 64 hex chars)
AES_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# File-level encryption key (used by file storage services)
FILE_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY


# ── WEBAUTHN / PASSKEYS ──────────────────────────────────────
# [OPTIONAL — enables biometric/passkey login]
# RP = Relying Party. Must match your domain in production.
WEBAUTHN_RP_NAME=W-Commerce
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5175
# Production:
# WEBAUTHN_RP_ID=yourdomain.com
# WEBAUTHN_ORIGIN=https://yourdomain.com


# ── PAYMENT GATEWAYS ─────────────────────────────────────────
# At least one gateway must be configured for payments to work.
DEFAULT_PROVIDER=PAYSTACK

# Paystack (Primary — NGN)
# Get keys from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_KEY
# Primary secret key alias used by some services — keep in sync with PAYSTACK_SECRET_KEY
PAYSTACK_PRIMARY_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY

# Stripe (USD / International)
# Get keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Stripe Connect (Marketplace Split Payments)
STRIPE_CONNECT_CLIENT_ID=ca_REPLACE
STRIPE_CONNECT_SECRET=sk_REPLACE

# Monnify (NGN — Alternative)
# Get keys from: https://developers.monnify.com
MONNIFY_API_KEY=MK_TEST_REPLACE
MONNIFY_SECRET_KEY=REPLACE_WITH_YOUR_MONNIFY_SECRET
MONNIFY_CONTRACT_CODE=REPLACE_WITH_YOUR_CONTRACT_CODE

# Flutterwave (Optional)
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=


# ── PLATFORM ECONOMICS ───────────────────────────────────────
# Platform commission rate (decimal, e.g. 0.05 = 5%)
PLATFORM_COMMISSION_RATE=0.05

# Base shipping rate in NGN (overridden by store config per seller)
SHIPPING_BASE_RATE=750

# Threshold above which batch/bulk operations are triggered
BULK_REQUEST_THRESHOLD=100


# ── SOCIAL AUTH ──────────────────────────────────────────────
# Google OAuth — get from https://console.developers.google.com
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Apple Sign-In (Optional)
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_REDIRECT_URI=http://localhost:5000/auth/apple/callback


# ── EMAIL ────────────────────────────────────────────────────
# Option A: SendGrid
SENDGRID_API_KEY=SG.REPLACE_WITH_YOUR_SENDGRID_KEY
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=W-Commerce

# Option B: Generic SMTP (if no SendGrid key, the validator falls back to SMTP)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# Set to true to log emails to console instead of sending (dev only)
ALLOW_EMAIL_SIMULATION=true


# ── SMS ──────────────────────────────────────────────────────
# Provider selection: TWILIO | TERMII | SIMULATION
SMS_PROVIDER=SIMULATION
SMS_FROM_NUMBER=+2348000000000

# Twilio
TWILIO_ACCOUNT_SID=REPLACE_WITH_YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_YOUR_TWILIO_TOKEN
TWILIO_VERIFY_SID=REPLACE_WITH_YOUR_TWILIO_VERIFY_SID
TWILIO_FROM_NUMBER=+15000000000

# Set to true to log SMS to console instead of sending (dev only)
ALLOW_SMS_SIMULATION=true


# ── PUSH NOTIFICATIONS (Web Push / VAPID) ───────────────────
# Generate secrets with: node scripts/generate-secrets.cjs
VAPID_PUBLIC_KEY=REPLACE_WITH_YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_YOUR_VAPID_PRIVATE_KEY


# ── AI & EXTERNAL APIS ───────────────────────────────────────
# Gemini API (Google AI) — used by aiController.js (Phase integration)
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# Google Maps (delivery routing, pickup station map)
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_MAPS_KEY

# Exchange Rate API (multi-currency wallet)
EXCHANGE_RATE_API_KEY=REPLACE_WITH_YOUR_KEY
EXCHANGE_RATE_BASE_URL=https://api.exchangerate-api.com/v4/latest/USD


# ── DELIVERY TRACKING ────────────────────────────────────────
# External courier tracking integration (optional)
# TRACKING_PROVIDER=DELHIVERY
# TRACKING_API_KEY=


# ── STORAGE ──────────────────────────────────────────────────
# Option A: Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Option B: AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
# AWS_REGION=eu-west-1


# ── FEATURE FLAGS ────────────────────────────────────────────
ENABLE_CRON_JOBS=true
ENABLE_SOCKETS=true
ENABLE_PAYMENTS=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_NOTIFICATIONS=true
ENABLE_AI_CHAT=true # Enables AI product generation (requires GEMINI_API_KEY)

# Set to true to allow mock/stub external API calls in dev
ALLOW_MOCK_EXTERNAL_APIS=true

# Set to true to enable real-time inventory sync with external warehouses
ENABLE_REAL_INVENTORY_SYNC=false


# ── RATE LIMITING ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100


# ── LOGGING ──────────────────────────────────────────────────
# Levels: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# ── ADDITIONAL CONFIGS ────────────────────────────────────────
# KYC / Identity Verification
SMILE_IDENTITY_API_KEY=REPLACE_WITH_SMILE_IDENTITY_KEY
SMILE_IDENTITY_PARTNER_ID=REPLACE_WITH_PARTNER_ID
BVN_SALT=REPLACE_WITH_RANDOM_STRING

# Payment Gateways
FLW_SECRET_KEY=REPLACE_WITH_FLUTTERWAVE_SECRET
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
COINBASE_API_KEY=REPLACE_WITH_COINBASE_COMMERCE_KEY

# AI Services
STABILITY_AI_API_KEY=REPLACE_WITH_STABILITY_AI_KEY

# Push Notifications Email
VAPID_EMAIL=mailto:support@yourapp.com

# Seeding (dev only)
SEED_ADMIN_PASSWORD=REPLACE_WITH_SECURE_ADMIN_PASS
SEED_SELLER_PASSWORD=REPLACE_WITH_SECURE_SELLER_PASS

