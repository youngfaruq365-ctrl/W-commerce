app.post(['/api/ai-chat', '/api/v1/ai-chat'], (req, res) => {
    const { message } = req.body;
    let reply = "I am your GlobalX AI assistant. I'm currently in simulated mode.";
    const lower = message ? message.toLowerCase() : '';
    if (lower.includes('hello') || lower.includes('hi')) {
        reply = "Hello! How can I help you navigate GlobalX today?";
    } else if (lower.includes('wallet')) {
        reply = "You can access your wallet securely by clicking the Wallet icon below.";
    } else if (lower.includes('product') || lower.includes('shop')) {
        reply = "Looking for products? Try browsing our Flash Sales or Deals of the Month!";
    } else if (lower.includes('help') || lower.includes('support')) {
        reply = "For live support, please click the Live Chat bubble in the floating menu to speak with an agent.";
    }
    
    setTimeout(() => {
        res.json({ reply });
    }, 800);
});

