// In development, redirect any direct non-API browser navigation on the backend port to the Vite dev server
if (process.env.NODE_ENV !== 'production') {
    app.get('*', (req, res, next) => {
        if (req.method === 'GET' && !req.path.startsWith('/api') && !req.path.startsWith('/uploads')) {
            const frontendUrl = process.env.FRONTEND_URL || 'http://localhost:5175';
            return res.redirect(`${frontendUrl}${req.path === '/' ? '' : req.path}`);
        }
        next();
    });
}

// ============================================================================
// START SERVER WITH PROPER ERROR HANDLING
// ============================================================================

async function startServerWithErrorHandling() {
    if (globalStartup.serverStarted) {
        logger.warn('Server start attempted twice in same process - skipping duplicate start');
        return;
    }
    globalStartup.serverStarted = true;

    await redisReadyPromise;
    const redisStatus = redisManager.getStatus();
    if (isProduction && (!redisStatus.connected || redisStatus.useFallback)) {
        logger.error('FATAL: Redis-backed session store is unavailable in production. Server shutting down.');
        process.exit(1);
    }

    const basePort = parseInt(process.env.PORT, 10) || 5000;
    const maxAttempts = 2;
    let attempts = 0;
    let currentPort = basePort;

    const tryStart = () => {
        attempts += 1;

        if (serverInstance) {
            serverInstance.removeAllListeners('error');
        }

        serverInstance = server.listen(currentPort, () => {
            const addr = serverInstance.address();
            const boundPort = addr && addr.port ? addr.port : currentPort;
            logger.info(`🚀 GlobalX Server running on http://localhost:${boundPort}`);
            logger.info('✅ Socket.io Real-time engine active');
            logger.info(`🔧 Environment: ${process.env.NODE_ENV || 'development'}`);
            serverInstance.keepAliveTimeout = 65000;
            serverInstance.headersTimeout = 66000;

            // Start W-Delivery background workers
            try {
                require('./src/workers/dispatchOfferWorker').start();
                require('./src/workers/trackingFlushWorker').start();
                logger.info('✅ W-Delivery OS background workers started');
            } catch (err) {
                logger.error(`Failed to start W-Delivery workers: ${err.message}`);
            }
        });

        serverInstance.once('error', (error) => {
            if (error && error.code === 'EADDRINUSE') {
                logger.warn(`Port ${currentPort} is already in use.`);
                if (process.env.NODE_ENV === 'production') {
                    logger.error('Port in use in production. Exiting to avoid unexpected bind.');
                    process.exit(1);
                }

                if (attempts < maxAttempts) {
                    currentPort += 1;
                    logger.info(`Trying alternative port ${currentPort} (attempt ${attempts + 1}/${maxAttempts})`);
                    setTimeout(tryStart, 800);
                    return;
                }

                logger.error(`Failed to bind to a port after ${attempts} attempts. Exiting.`);
                process.exit(1);
            } else if (error && error.code === 'EACCES') {
                logger.error(`Permission denied on port ${currentPort}. Try a port above 1024.`);
                process.exit(1);
            } else {
                logger.error(`Server error during bind: ${error ? error.message : String(error)}`);
                if (error && error.stack) logger.error(error.stack);
                process.exit(1);
            }
        });
    };

    tryStart();
}

startServerWithErrorHandling().catch((error) => {
    logger.error(`Failed to start server: ${error.message}`);
    logger.error(error.stack);
    process.exit(1);
});
});