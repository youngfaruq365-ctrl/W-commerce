function directoryExists(dirPath) {
    try {
        return fs.existsSync(dirPath) && fs.lstatSync(dirPath).isDirectory();
    } catch {
        return false;
    }
}

function fileExists(filePath) {
    try {
        return fs.existsSync(filePath) && fs.lstatSync(filePath).isFile();
    } catch {
        return false;
    }
}

function resolveFrontendHtml(fileName) {
    const publicHtmlPath = path.join(FRONTEND_DIRS.html, fileName);
    if (fileExists(publicHtmlPath)) return publicHtmlPath;
    return path.join(FRONTEND_DIRS.root, fileName);
}

function isBlockedRootStaticPath(requestPath) {
    const normalizedPath = (requestPath || '').toLowerCase();
    const blockedPrefixes = [
        '/src/',
        '/node_modules/',
        '/prisma/',
        '/logs/',
        '/scripts/',
        '/tests/',
        '/backups/',
        '/.git/',
        '/.github/',
        '/.vscode/',
        '/.idea/'
    ];

    if (blockedPrefixes.some(prefix => normalizedPath.startsWith(prefix))) {
        return true;
    }

    const blockedExactFiles = new Set([
        '/server.js',
        '/package.json',
        '/package-lock.json',
        '/docker-compose.yml',
        '/docker-compose.yaml',
        '/.env',
        '/.env.local',
        '/.env.production',
        '/.env.development'
    ]);

    if (blockedExactFiles.has(normalizedPath)) {
        return true;
    }

    if (normalizedPath.includes('..') || normalizedPath.includes('%2e%2e')) {
        return true;
    }

    // Keep the root static fallback limited to typical web assets.
    const ext = path.extname(normalizedPath);
    const allowedExtensions = new Set([
        '',
        '.html',
        '.css',
        '.js',
        '.mjs',
        '.map',
        '.glb',
        '.gltf',
        '.bin',
        '.webp',
        '.webp',
        '.webp',
        '.gif',
        '.webp',
        '.svg',
        '.ico',
        '.txt',
        '.xml',
        '.webmanifest'
    ]);

    if (!allowedExtensions.has(ext)) {
        return true;
    }

    return false;
}

// 🚀 SECURITY & PERFORMANCE ENHANCEMENTS
const isProduction = process.env.NODE_ENV === 'production';

app.use(helmet({
    contentSecurityPolicy: {
        directives: {
            defaultSrc: ["'self'"],
            scriptSrc: ["'self'", "'unsafe-inline'", "https://js.stripe.com", "https://cdn.jsdelivr.net", "https://accounts.google.com", "https://appleid.cdn-apple.com"],
            scriptSrcAttr: ["'unsafe-inline'"],
            styleSrc: ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com", "https://cdn.jsdelivr.net", "https://cdnjs.cloudflare.com"],
            fontSrc: ["'self'", "https://fonts.gstatic.com", "https://cdnjs.cloudflare.com", "data:"],
            imgSrc: ["'self'", "data:", "blob:", "https:", "http:"],
            connectSrc: ["'self'", "https://api.stripe.com", "https://accounts.google.com", "https://api.exchangerate-api.com", "wss:", "ws:"],
            frameSrc: ["'self'", "https://js.stripe.com", "https://accounts.google.com"],
            mediaSrc: ["'self'"],
            objectSrc: ["'none'"],
            ...(isProduction ? { upgradeInsecureRequests: [] } : {})
        }
    },
    crossOriginEmbedderPolicy: false,
    // HSTS - Force HTTPS in production
    hsts: isProduction ? {
        maxAge: 31536000, // 1 year
        includeSubDomains: true,
        preload: true
    } : false
}));

// Home-route CSP overlay: tighter defaults without changing global policy for other pages.
app.use((req, res, next) => {
    const lowerPath = req.path.toLowerCase();
    const basePathLower = (BASE_PATH || '').toLowerCase();
    const isHomeRoute =
        lowerPath === '/' ||
        lowerPath === '/index.html' ||
        (basePathLower && (lowerPath === basePathLower || lowerPath === `${basePathLower}/` || lowerPath === `${basePathLower}/index.html`));

    if (!isHomeRoute) {
        return next();
    }

    const homeCsp = [
        "default-src 'self'",
        "script-src 'self' 'unsafe-inline' https://js.stripe.com https://cdn.jsdelivr.net https://accounts.google.com https://appleid.cdn-apple.com",
        "script-src-attr 'unsafe-inline'",
        "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com",
        "font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:",
        "img-src 'self' data: blob: https: http:",
        "connect-src 'self' https://api.stripe.com https://accounts.google.com https://api.exchangerate-api.com wss: ws:",
        "frame-src 'self' https://js.stripe.com https://accounts.google.com",
        "media-src 'self'",
        "object-src 'none'",
        "base-uri 'self'",
        "frame-ancestors 'self'",
        "form-action 'self'"
    ];

    if (isProduction) {
        homeCsp.push('upgrade-insecure-requests');
    }

    res.setHeader('Content-Security-Policy', homeCsp.join('; '));
    next();
});
app.use(compression()); // Gzip compression
