{
  "name": "w-commerce-workspace",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:production": "npm run build --workspace=frontend",
    "db:sync-postgres-schema": "node scripts/sync-postgres-schema.cjs",
    "db:generate:prod": "prisma generate --schema=database/prisma/postgres/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=database/prisma/postgres/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
