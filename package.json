{
    "name": "w-commerce-project",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite frontend --port 5175",
        "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build frontend",
        "lint": "oxlint",
        "preview": "vite preview frontend",
        "start": "node backend/server.cjs",
        "dev:server": "nodemon --watch backend --ignore dev.db --ignore dev.db-journal backend/server.cjs",
        "db:generate": "prisma generate --schema=database/prisma/schema.prisma",
        "db:push": "prisma db push --schema=database/prisma/schema.prisma",
        "dev:portfolio": "npm run dev --prefix ultra3pro-portfolio",
        "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\" \"npm run dev:portfolio\"",
        "build:production": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build frontend --mode production",
        "secrets:generate": "node scripts/generate-production-secrets.cjs",
        "db:migrate:prod": "prisma migrate deploy --schema=database/prisma/schema.prisma",
        "start:production": "NODE_ENV=production node backend/server.cjs"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.400.0",
        "@prisma/client": "^5.0.0",
        "@simplewebauthn/browser": "^13.3.0",
        "@simplewebauthn/server": "^13.3.2",
        "@tanstack/react-query": "^5.101.2",
        "axios": "^1.18.1",
        "bcryptjs": "^2.4.3",
        "canvas-confetti": "^1.9.4",
        "cloudinary": "^2.9.0",
        "clsx": "^2.1.1",
        "compression": "^1.8.1",
        "connect-redis": "^7.1.1",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.6",
        "dotenv": "^16.6.1",
        "emoji-picker-react": "^4.19.1",
        "express": "^4.22.1",
        "express-rate-limit": "^8.7.0",
        "express-session": "^1.19.0",
        "framer-motion": "^12.42.2",
        "glob": "^13.0.6",
        "helmet": "^7.2.0",
        "i18next": "^23.2.11",
        "isomorphic-dompurify": "^2.35.0",
        "jsonwebtoken": "^9.0.3",
        "leaflet": "^1.9.4",
        "lottie-react": "^2.4.1",
        "lucide-react": "^1.24.0",
        "morgan": "^1.10.1",
        "multer": "^2.0.2",
