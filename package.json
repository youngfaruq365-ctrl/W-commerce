        "react-hot-toast": "^2.6.0",
        "react-is": "^19.2.8",
        "react-leaflet": "^5.0.0",
        "react-qr-code": "^2.2.0",
        "react-router-dom": "^7.18.1",
        "react-signature-canvas": "^1.1.0-alpha.2",
        "react-webcam": "^7.2.0",
        "recharts": "^3.10.1",
