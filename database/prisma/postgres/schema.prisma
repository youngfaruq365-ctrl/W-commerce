  productId            String
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  currentDiscountPct   Int      @default(0) // 2, 4, 5
  currentStage         Int      @default(0) // 0, 1, 2, 3
  
  nextClaimAvailableAt DateTime?
  expiresAt            DateTime?
  isCompleted          Boolean  @default(false)
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  @@unique([buyerId, productId])
  @@index([buyerId])
  @@index([productId])
  @@index([nextClaimAvailableAt])
}

model Address {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  type              String             @default("SHIPPING") // SHIPPING, BILLING
  street            String
  city              String
  state             String
  postalCode        String
  country           String
  isDefault         Boolean            @default(false)
  marketplaceOrders MarketplaceOrder[] @relation("MarketplaceOrderAddress")
}

model Store {
