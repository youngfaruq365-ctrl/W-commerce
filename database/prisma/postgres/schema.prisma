  user     User   @relation(fields: [sellerId], references: [id])

  storeName   String
  category    String?
  description String?
  logoUrl     String?
  bannerUrl   String?
  country     String

  isVerified Boolean @default(false)
  kycTier    Int     @default(1)
  trustScore Int     @default(50) // 0-100

  // Store Approval Workflow
  approvalStatus      String    @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  approvedAt          DateTime? // When store was approved
  rejectionReason     String? // Why store was rejected
  complianceScore     Int? // Compliance check score (0-100)
  lastComplianceCheck DateTime? // When last compliance check was done

  // Performance Score (0-100) - composite of rating, trust, metrics
  performanceScore Int @default(50)

  // Banning Rating System
  banningRate             Float     @default(0.0)
  disputePenaltyAppliedAt DateTime?

  // Premium Features
  isPremium       Boolean @default(false)
  showAdsOnStorefront Boolean @default(false) // For basic sellers
  portfolioLayout String?
  portfolioSlug   String? @unique
  portfolioConfig String?
  brandStory      String?

  // Store DNA Engine
  storeDna          String?
  storeDnaDraft     String?
  storeDnaVersion   Int       @default(1)
  storeDnaUpdatedAt DateTime?

  // Ratings
  averageRating Float @default(0.0)
  totalReviews  Int   @default(0)

  // Fulfillment metrics
  defaultDeliveryDays Int     @default(5)
  onTimeDeliveryRate  Decimal @default(0.0)
  avgResponseMinutes  Int     @default(45)

  // Business Intelligence
  totalSales            Decimal @default(0)
  totalOrders           Int     @default(0)
  repeatBuyerRate       Decimal @default(0)
  topSellingProductId   String?
  topSellingProductName String?

  // Alerts
  hasPendingAlerts Boolean   @default(false)
  alertMessage     String?
  lastAlertAt      DateTime?

  // Tier-based benefits
  sellerTier   String      @default("STANDARD") // STANDARD, PREMIUM, ELITE
  sellerPlanId String?
  sellerPlan   SellerPlan? @relation(fields: [sellerPlanId], references: [id])

  // Seller-configured plan benefits and payout rails
  enabledBenefits       String?
  bankName              String?
  accountNumber         String?
  accountName           String?
  bankCode              String?
  paystackRecipientCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  integrations StoreIntegration[]
  planBenefits SellerPlanBenefit[]
  Conversation Conversation[]

  // Template Marketplace
  appliedTemplates SellerTemplate[]

  @@index([sellerId])
  @@index([performanceScore])
  @@index([hasPendingAlerts])
}

model BuyerRequest {
  id                 String    @id @default(uuid())
  buyerId            String    @map("buyer_id")
  buyer              User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productName        String    @map("product_name")
  description        String
  budget             Decimal
  preferredBudgetMax Decimal?
  quantity           Int       @default(1)
  urgency            String    @default("STANDARD")
  category           String?
  location           String?
  neededBy           DateTime?
  isBulkRequest      Boolean   @default(false)
  demandScore        Int       @default(0)
  status             String    @default("OPEN") // OPEN, RESPONDED, QUOTED, ACCEPTED
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  responses RequestResponse[]

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
  @@map("buyer_requests")
}

model RequestResponse {
  id                    String       @id @default(uuid())
  requestId             String       @map("request_id")
  request               BuyerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sellerId              String       @map("seller_id")
  seller                User         @relation("SellerRequestResponses", fields: [sellerId], references: [id], onDelete: Cascade)
  responseType          String       @map("response_type") // ACCEPT, DECLINE, QUOTE
  message               String?
  quotedPrice           Decimal?     @map("quoted_price")
  alternativeSuggestion String?
  estimatedDeliveryDays Int?
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  @@unique([requestId, sellerId])
  @@index([requestId, createdAt])
  @@index([sellerId, createdAt])
  @@map("request_responses")
}

// External Platform Integration (Shopify, WooCommerce)
model StoreIntegration {
  id          String    @id @default(uuid())
  store       Store     @relation(fields: [storeId], references: [id])
  storeId     String
  platform    String // "shopify" or "woocommerce"
  credentials String // Encrypted JSON: API keys, tokens
  status      String    @default("pending") // pending, connected, error
  lastSync    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([storeId])
}

model Product {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  title       String
  description String?
  price       Decimal
  stock       Int
  shippingFee Decimal @default(0)

  // Low stock threshold (default 5)
  lowStockThreshold Int @default(5)

  // Audio background track
  audioUrl   String?
  audioTitle String?

  category              String
  subCategory           String?
  tags                  String?
  sku                   String?
  hsCode                String?
  weightKg              Float?
  originHub             String?
  estimatedDeliveryDays Int     @default(5)

  // Product Grouping
  productGroupId  String?
  normalizedTitle String?

  // Flash Sales
  isFlashSale      Boolean   @default(false)
  flashPrice       Decimal?
  flashEndsAt      DateTime?
  earlyAccessTiers String?
  exclusiveTier    String?

  // Urgency & Boost
  urgencyLevel           String    @default("NORMAL")
  autoBoostExpiresAt     DateTime?
  isUrgencyBannerVisible Boolean   @default(false)
  
  // Ad Boosts
  isAdBoosted            Boolean   @default(false)
  adBoostExpiresAt       DateTime?

  viewCount  Int     @default(0)
  soldCount  Int     @default(0)
  rating     Float   @default(0.0)
  isArchived Boolean @default(false)

  // Negotiation / Seller Minimum Price
  isNegotiable Boolean  @default(false)
  bottomPrice  Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images            ProductImage[]
  videos            ProductVideo[]
  options           ProductOption[]
  orderItems        OrderItem[]
  cartItems         CartItem[]
  feedPosts         FeedPost[]
  events            EngagementEvent[]         @relation("ProductEvents")
  pool              Pool?
  reviews           Review[]
  offers            ProductOffer[]
  questions         ProductQuestion[]
  comparisons       ProductComparison[]       @relation("ComparisonPrimary")
  comparedIn        ProductComparison[]       @relation("ComparisonCompared")
  modelAssets       ProductModelAsset[]
  pageViews         PageView[]
  buyerInteractions BuyerProductInteraction[]

  // Promo Codes
  promoCodes PromoCode[]

  // Flash Deals
  flashDeals FlashDeal[]

  // Messages
  messages Message[]

  // Wishlist reference (reverse)
  wishlistedBy Wishlist[] @relation("ProductWishlists")

  // Urgency tracking
  urgency ProductUrgency?

  // Restock notifications
  restockNotifications RestockNotification[] @relation("ProductRestockNotifications")

  fulfillmentItems      FulfillmentItem[]      @relation("FulfillmentItemProduct")
  inventoryReservations InventoryReservation[] @relation("InventoryReservationProduct")
  
  adDiscountSessions    AdDiscountSession[]

  @@index([category, createdAt])
  @@index([category, price])
  @@index([storeId])
  @@index([title])
  @@index([sku])
  @@index([productGroupId])
  @@index([normalizedTitle])
  @@index([urgencyLevel])
  @@index([isUrgencyBannerVisible])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean @default(false)
  position  Int     @default(0)

  @@index([productId])
}

model ProductVideo {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  videoUrl     String
  thumbnailUrl String?
  caption      String?
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([productId])
}

model ProductOption {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // e.g. "Color", "Size"
  value     String // e.g. "Midnight Blue", "XL"
  priceAdj  Decimal @default(0.0) // Extra cost for this option

  @@index([productId])
}

model ProductOffer {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User      @relation("BuyerProductOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User      @relation("SellerProductOffers", fields: [sellerId], references: [id], onDelete: Cascade)
  offerAmount Decimal
  quantity    Int       @default(1)
  message     String?
  status      String    @default("PENDING") // PENDING, ACCEPTED, DECLINED, EXPIRED, CANCELLED
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId, createdAt])
  @@index([buyerId, createdAt])
  @@index([sellerId, status])
}

model ProductQuestion {
  id           String    @id @default(uuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     String
  answer       String?
  answeredById String?
  answeredAt   DateTime?
  status       String    @default("OPEN") // OPEN, ANSWERED, HIDDEN
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

model ProductComparison {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation("ComparisonPrimary", fields: [productId], references: [id], onDelete: Cascade)
  comparedProductId String
  comparedProduct   Product  @relation("ComparisonCompared", fields: [comparedProductId], references: [id], onDelete: Cascade)
  metadata          String?
  createdAt         DateTime @default(now())

  @@unique([userId, productId, comparedProductId])
  @@index([userId, createdAt])
}

model ProductModelAsset {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetUrl     String
  format       String   @default("GLB")
  thumbnailUrl String?
  fileSizeKb   Int?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
  @@index([status])
}

model Pool {
  id        String  @id @default(uuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])

  title       String // e.g. "Community Buy #102"
  targetSize  Int // e.g. 20 members
  currentSize Int      @default(0)
  minBuyIn    Decimal
  expiresAt   DateTime

  status String @default("ACTIVE") // ACTIVE, FILLED, COMPLETED, EXPIRED, CANCELLED

  participants PoolParticipant[]
  createdAt    DateTime          @default(now())
}

model PoolParticipant {
  id       String   @id @default(uuid())
  poolId   String
  pool     Pool     @relation(fields: [poolId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  joinedAt DateTime @default(now())
  status   String   @default("COMMITTED") // COMMITTED, PAID, REFUNDED

  @@unique([poolId, userId])
}

model Order {
  id      String @id @default(uuid())
  buyerId String
  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id])

  // Multi-seller parent/child relation
  parentOrderId String?
  parentOrder   Order?  @relation("SubOrders", fields: [parentOrderId], references: [id])
  subOrders     Order[] @relation("SubOrders")

  // Financials
  totalAmount      Decimal
  currency         String   @default("USD")
  shippingCost     Decimal
  taxAmount        Decimal
  commissionRate   Float    @default(0.10)
  commissionAmount Decimal?
  sellerAmount     Decimal?

  // Fulfillment Status (order lifecycle)
  status String @default("PENDING") // PENDING, PAID, PACKED, CONFIRMED, SHIPPED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, COMPLETED, CANCELLED

  // Payment/Escrow Status (fund lifecycle - separate from fulfillment)
  paymentStatus String @default("PENDING") // PENDING, HELD, RELEASED, DISPUTED, REFUNDED

  paymentMethod   String?
  stripePaymentId String?
  proofUrl        String?
  escrowId        String?
  orderType       String  @default("PHYSICAL")
  idempotencyKey  String? @unique

  // Seller Reference
  sellerId                String?
  seller                  User?     @relation("SellerOrders", fields: [sellerId], references: [id])
  packingSerial           String?   @unique
  packingConfirmationCode String?
  packedAt                DateTime?
  packageConfirmedAt      DateTime?
  readyToShipAt           DateTime?
  responseDueAt           DateTime?
  escalatedAt             DateTime?

  // Penalty Tracking
  unpackPenaltyApplied    Boolean   @default(false)
  unshipPenaltyApplied    Boolean   @default(false)

  // Delivery Intelligence
  estimatedDeliveryDate    DateTime?
  deliveryConfirmationCode String?
  deliveryConfirmedAt      DateTime?
  lastTrackingUpdateAt     DateTime?
  isDeliveryDelayed        Boolean   @default(false)
  delayReason              String?

  // Escrow Timing
  deliveredAt      DateTime?
  escrowReleaseAt  DateTime?
  escrowReleasedAt DateTime?

  // Consolidation
  isConsolidated        Boolean              @default(false)
  hubLocation           String?
  consolidatedPackageId String?
  consolidatedPackage   ConsolidatedPackage? @relation(fields: [consolidatedPackageId], references: [id], onDelete: SetNull)

  // Shipping
  shippingAddressId  String?
  shippingAddress    String?
  trackingNumber     String?
  carrier            String?
  carrierService     String?
  originCountry      String?
  destinationCountry String?

  items              OrderItem[]
  trackingEvents     TrackingEvent[]
  dispute            Dispute?
  paymentProof       PaymentProof?
  escrowPayment      EscrowPayment?
  payments           Payment[]
  buyerNotifications BuyerNotification[]
  packingResponse    PackingResponse?
  packingIssue       PackingIssue?
  messages           Message[]
  deliveryAssignment DeliveryAssignment?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  expiresAt          DateTime? // For PENDING order checkout expiration

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([escrowReleaseAt])
  @@index([sellerId])
  @@index([estimatedDeliveryDate])
  @@index([isDeliveryDelayed])
}

// Payment Proof for Direct Bank Transfers
model PaymentProof {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Buyer Information
  buyerId   String
  buyerName String

  // Seller Information (assigned seller)
  sellerId   String
  sellerName String

  // Payment Details
  amount         Decimal
  currency       String  @default("USD")
  bankName       String
  accountNumber  String? // Last 4 digits only for security
  transactionRef String // Buyer\'s transaction reference

  // Proof Image
  proofImageUrl String
  proofImageId  String? // CDN/Cloud storage ID

  // Status Workflow
  status String @default("PENDING") // PENDING, SUBMITTED, UNDER_REVIEW, VERIFIED, REJECTED, COMPLETED

  // Seller Response
  sellerResponse   String? // Notes from seller
  sellerVerifiedAt DateTime?

  // Admin Review
  adminReviewedAt DateTime?
  adminNotes      String?

  // Receipt
  receiptUrl         String?
  receiptNumber      String?   @unique
  receiptGeneratedAt DateTime?

  // Audit Trail
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Notifications
  buyerNotified  Boolean @default(false)
  sellerNotified Boolean @default(false)
  adminNotified  Boolean @default(false)

  // Audit Logs Relation
  auditLogs PaymentAuditLog[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

// Payment Audit Log for complete audit trail
model PaymentAuditLog {
  id             String       @id @default(uuid())
  paymentProofId String
  paymentProof   PaymentProof @relation(fields: [paymentProofId], references: [id])

  // User who performed the action
  userId   String
  userName String
  userRole String // BUYER, SELLER, ADMIN

  // Action details
  action         String // STATUS_CHANGE, SUBMITTED, VERIFIED, REJECTED, RECEIPT_SENT, etc.
  previousStatus String?
  newStatus      String?
  notes          String?

  // Tracking
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([paymentProofId])
  @@index([userId])
  @@index([action])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity    Int
  priceAtTime Decimal
  variants    String? // JSON or text: "Size: XL, Color: Blue"

  // Status per item (for multi-seller orders)
  status String @default("PENDING")

  @@index([orderId])
  @@index([productId])
}

model Dispute {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User   @relation("BuyerDisputes", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerDisputes", fields: [sellerId], references: [id])

  reason       String // WRONG_ITEM, DAMAGED, NOT_AS_DESCRIBED, NOT_RECEIVED, OTHER
  description  String
  evidenceUrls String // JSON array
  status       String  @default("OPEN") // OPEN, SELLER_RESPONSE, MEDIATION, RESOLVED_REFUNDED, RESOLVED_REPLACEMENT, RESOLVED_REJECTED
  resolution   String?
  adminNotes   String?
  adminId      String?

  sellerResponse   String? // SELLER_REFUND_APPROVED, SELLER_REPLACEMENT, SELLER_NEED_PROOF, SELLER_REJECTED
  sellerResponseAt DateTime?
  buyerResponse    String? // BUYER_ACCEPT, BUYER_REJECT, BUYER_ESCALATE

  responseDeadline DateTime? // 48 hours from creation
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  messages DisputeMessage[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model DisputeMessage {
  id        String  @id @default(uuid())
  disputeId String
  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  senderId   String
  senderType String // BUYER, SELLER, ADMIN

  message     String
  evidenceUrl String? // Optional image evidence

  createdAt DateTime @default(now())

  @@index([disputeId])
}

model PackingIssue {
  id                     String    @id @default(uuid())
  orderId                String    @unique
  order                  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId                String
  buyer                  User      @relation("BuyerPackingIssues", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId               String
  seller                 User      @relation("SellerPackingIssues", fields: [sellerId], references: [id], onDelete: Cascade)
  issueType              String
  buyerMessage           String?
  status                 String    @default("OPEN") // OPEN, SELLER_RESPONDED, ESCALATED, CLOSED
  responseDeadline       DateTime?
  sellerRespondedAt      DateTime?
  escalatedAt            DateTime?
  responseLatencyMinutes Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([sellerId, status])
  @@index([buyerId, createdAt])
  @@index([responseDeadline])
}

model VerificationRequest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type         String // KYC (Buyer/Personal), KYB (Business/Store)
  status       String  @default("PENDING") // PENDING, APPROVED, REJECTED
  idType       String? // PASSPORT, DRIVERS_LICENSE, NATIONAL_ID
  idNumber     String?
  documentUrls String // JSON array of uploaded docs

  adminNotes String?

  sellerType       String?
  identityData     String? // JSON
  businessData     String? // JSON
  ownershipData    String? // JSON
  addressData      String? // JSON
  payoutData       String? // JSON
  sectionStatuses  String? // JSON
  rejectionReasons String? // JSON
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Review {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  userId    String
  user      User    @relation("UserReviews", fields: [userId], references: [id])
  sellerId  String
  seller    User    @relation("SellerReviews", fields: [sellerId], references: [id])

  rating     Int
  comment    String?
  images     String
  isFeatured Boolean   @default(false)
  reply      String?
  repliedAt  DateTime?

  // Engagement
  helpfulCount Int     @default(0)
  reportCount  Int     @default(0)
  isTopReview  Boolean @default(false)

  // Verification
  verifiedPurchase Boolean @default(true)
  orderId          String?
  transactionHash  String?

  // Relations
  likes   ReviewLike[]   @relation("ReviewLikes")
  reports ReviewReport[] @relation("ReviewReportsOnReview")

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@index([sellerId])
  @@index([rating])
  @@index([isTopReview])
  @@index([createdAt])
}

// Messaging System
model Conversation {
  id        String   @id @default(uuid())
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  type      String   @default("DIRECT") // DIRECT, GROUP, SUPPORT
  status    String   @default("ACTIVE") // ACTIVE, ARCHIVED, CLOSED
  context   String? // GENERAL, ORDER, PRODUCT
  contextId String? // Order ID or Product ID related to chat
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  lastReadAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id])

  recipientId String? // Optional direct reference for quick lookup
  recipient   User?   @relation("ReceivedMessages", fields: [recipientId], references: [id])

  // Context: linked product and/or order
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])

  content       String
  attachmentUrl String?
  metadata      String?
  feedComment   FeedComment? @relation("FeedCommentMessage")

  isSystemMessage     Boolean  @default(false)
  isAutoReply         Boolean  @default(false)
  responseTimeMinutes Int?
  createdAt           DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([recipientId, createdAt])
}

// Quick Reply Templates for Sellers
model QuickReplyTemplate {
  id       String @id @default(uuid())
  sellerId String
  title    String // Short title shown in quick reply menu
  content  String // The actual message template

  // Category for organizing templates
  category String @default("general") // general, shipping, payment, thanks, custom

  isActive   Boolean  @default(true)
  usageCount Int      @default(0) // Track how often used
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sellerId])
  @@index([category])
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  title   String
  body    String
  type    String // INFO, ORDER, POOL, ALERT
  isRead  Boolean @default(false)
  linkUrl String?
  data    String? // Notification OS JSON payload

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model SellerFollow {
  id        String   @id @default(uuid())
  buyerId   String
  buyer     User     @relation("BuyerFollowsSeller", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation("SellerHasFollowers", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([buyerId, sellerId])
  @@index([sellerId, createdAt])
}

model BuyerProductInteraction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  interactionType String // VIEW, RECENT_VIEW, CART, PURCHASE, WISHLIST
  weight          Int      @default(1)
  source          String?
  metadata        String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([productId, createdAt])
  @@index([interactionType, createdAt])
}

// Buyer Notifications for Seller Dashboard
model BuyerNotification {
  id      String  @id @default(uuid())
  userId  String // Buyer ID
  user    User    @relation(fields: [userId], references: [id])
  orderId String? // Nullable for non-order-specific alerts
  order   Order?  @relation(fields: [orderId], references: [id])

  message     String // Notification text
  type        String // order_due, delivery_update, product_availability
  channel     String    @default("in_app") // in_app, email, sms, push
  readStatus  Boolean   @default(false)
  isVisible   Boolean   @default(true)
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

