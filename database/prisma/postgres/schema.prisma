// User Roles and OrderStatus managed as String for compatibility

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  passwordHash            String
  withdrawPin             String?
  fullName                String
  role                    String    @default("BUYER")
  avatarUrl               String?
  phone                   String?
  username                String?   @unique
  dob                     String?
  gender                  String?
  bio                     String?
  instagram               String?
  twitter                 String?
  website                 String?
  isVerified              Boolean   @default(false)
  kycTier                 Int       @default(1) // Tier 1: Email Verified, Tier 2: ID Verified, Tier 3: Business Verified
  verificationLevel       String    @default("BASIC") // BASIC, VERIFIED, ELITE
  hasPaidAccess           Boolean   @default(false)
  subscriptionTier        String    @default("NONE") // NONE, MONTHLY, YEARLY
  accessExpiry            DateTime?
  verificationCode        String?
  verificationCodeExpires DateTime?
  balance                 Decimal   @default(0.0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  country String? // User's country for activity broadcasts

  // Social Login
  googleId     String? @unique
  appleId      String? @unique
  authProvider String  @default("LOCAL") // LOCAL, GOOGLE, APPLE

  // Security
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  isFlagged           Boolean   @default(false) // Admin: flagged for suspicious activity

  // GDPR
  deletionScheduledAt DateTime?
  deletionReason      String?

  // Nigerian Bank Details (for Paystack payouts)
  bankName           String?
  accountNumber      String?
  accountName        String?
  bankCode           String? // Nigerian bank code
  paystackSubaccount String? // Paystack subaccount code

  // Stripe Connect Account (for global payouts)
  stripeConnectId             String? // Stripe Connect account ID
  stripeConnectStatus         String? // pending, verified, failed
  stripeConnectChargesEnabled Boolean @default(false)
  stripeConnectPayoutsEnabled Boolean @default(false)

  // Relations
  addresses            Address[]
  orders               Order[]                   @relation("BuyerOrders")
  consolidatedPackages ConsolidatedPackage[]     @relation("BuyerConsolidatedPackages")
  sellerOrders         Order[]                   @relation("SellerOrders")
  store                Store?
  reviewsWritten       Review[]                  @relation("UserReviews")
  reviewsReceived      Review[]                  @relation("SellerReviews")
  cart                 Cart?
  buyerRequests        BuyerRequest[]
  productInteractions  BuyerProductInteraction[]
  payAIOrders          PayAIOrder[]              @relation("PayAIUserOrders")

  // Group Buys
  poolEntries PoolParticipant[]

  // Disputes & Verification
  disputesRaised       Dispute[]             @relation("BuyerDisputes")
  disputesAgainst      Dispute[]             @relation("SellerDisputes")
  verificationRequests VerificationRequest[]

  // Chat
  sentMessages     Message[]                 @relation("SentMessages")
  receivedMessages Message[]                 @relation("ReceivedMessages")
  conversations    ConversationParticipant[]
  requestResponses RequestResponse[]         @relation("SellerRequestResponses")

  // System
  notifications         Notification[]
  notificationPrefs     String                      @default("{\"email\":true,\"orderUpdates\":true,\"marketing\":false}")
  pushSubscription      String?
  buyerNotifications    BuyerNotification[]
  followedSellers       SellerFollow[]              @relation("BuyerFollowsSeller")
  sellerFollowers       SellerFollow[]              @relation("SellerHasFollowers")
  analyticsEvents       MarketplaceAnalyticsEvent[]
  createdPromoCampaigns PromoCampaign[]             @relation("CampaignCreator")
  buyerProfiles         BuyerSellerProfile[]        @relation("BuyerSellerProfiles")
  sellerBuyerProfiles   BuyerSellerProfile[]        @relation("SellerBuyerProfiles")
  buyerPackingIssues    PackingIssue[]              @relation("BuyerPackingIssues")
  sellerPackingIssues   PackingIssue[]              @relation("SellerPackingIssues")

  // Review Engagement
  reviewLikes        ReviewLike[]   @relation("UserReviewLikes")
  reviewReports      ReviewReport[] @relation("ReviewReports")
  adminReviewReports ReviewReport[] @relation("AdminReviewReports")

  // Restock Notifications
  restockNotifications RestockNotification[]

  // Wishlist
  wishlists Wishlist[] @relation("UserWishlist")

  // Seller Performance
  performanceRecords SellerPerformance[] @relation("SellerPerformanceRecords")
  sellerInsights     SellerInsight[]     @relation("SellerInsights")

  // Financials
  wallet             Wallet?
  payouts            Payout[]
  transactions       Transaction[]
  systemLogs         SystemLog[]
  subscriptions      Subscription[]
  rewardGrants       RewardGrant[]
  productOffers      ProductOffer[]      @relation("BuyerProductOffers")
  sellerOffers       ProductOffer[]      @relation("SellerProductOffers")
  productQuestions   ProductQuestion[]
  productComparisons ProductComparison[]

  // Promo Codes
  promoCodes PromoCode[]

  // Nigerian Payment Relations
  buyerPayments   Payment[]        @relation("BuyerPayments")
  sellerPayments  Payment[]        @relation("SellerPayments")
  paymentDisputes PaymentDispute[]

  // Flash Deals
  flashDeals FlashDeal[]

  // Trial Subscription Fields
  trialStartDate      DateTime? // When the trial started
  trialEndDate        DateTime? // When the trial expires (6 months from start)
  trialStatus         String    @default("NONE") // NONE, ACTIVE, EXPIRED, CONVERTED, CANCELLED
  isTrialActive       Boolean   @default(false) // Quick check if trial is currently active
  trialConversionDate DateTime? // When trial was converted to paid
  trialPlan           String? // Plan user had during trial (MONTHLY, YEARLY)
  trialPromoCode      String? // Promo code used for trial signup

  feedComments         FeedComment[]     @relation("UserFeedComments")
  feedCommentsReceived FeedComment[]     @relation("FeedCommentSeller")
  feedPosts            FeedPost[]        @relation("SellerFeedPosts")
  likes                Like[]            @relation("UserLikes")
  events               EngagementEvent[] @relation("UserEvents")

  // Template Marketplace
  templatePurchases TemplatePurchase[]
  ownedTemplates    SellerTemplate[]

  // Delivery OS
  courierProfile CourierProfile?

  // Sessions & WebAuthn
  userSessions        UserSession[]
  webAuthnCredentials WebAuthnCredential[]

  marketplaceOrders   MarketplaceOrder[] @relation("MarketplaceOrderBuyer")
  fulfillmentAsBuyer  FulfillmentOrder[] @relation("FulfillmentBuyer")
  fulfillmentAsSeller FulfillmentOrder[] @relation("FulfillmentSeller")

  notificationPreferences NotificationPreference?
  
  adDiscountSessions  AdDiscountSession[]

  @@index([email])
}

model AdDiscountSession {
